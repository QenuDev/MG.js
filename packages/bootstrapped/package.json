{
  "name": "@mg.js/bootstrapped",
  "version": "0.1.4",
  "type": "module",
  "description": "In-page / userscript Magic Garden client: attaches to the game's own Quinoa socket, renders through the game's Pixi stage, and coexists with other mods.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "npm run build",
    "test": "node --import tsx --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@mg.js/common": "^0.1.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/QenuDev/MG.js.git",
    "directory": "packages/bootstrapped"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false
}
