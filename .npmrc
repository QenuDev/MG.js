# npm's default cache is read-only on this machine (EROFS on ~/.npm/_cacache), which broke
# `npm install`, `npm pack` and `npm ci`. Point the cache at a workspace-local directory instead:
# it is already gitignored (.gitignore: `.npm-cache/`).
#
# Set here rather than in a shell profile so the repo works the same on any machine and in CI.
cache=.npm-cache
